# Required for docker-compose.yml
ADMIN_SLUG=replace-with-long-random-slug
SECRET_KEY=replace-with-64-hex-chars

# Optional app settings
USER_TIMEZONE=UTC
SESSION_COOKIE_SECURE=false
MAX_NAME_LENGTH=120
FLASK_DEBUG=false

# Email reminders (all required before the worker sends mail)
PUBLIC_BASE_URL=https://cadence.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Cadence <reminders@example.com>
SMTP_USE_TLS=true
REMINDER_RECIPIENT=you@example.com
REMINDER_DIGEST_HOUR=8
EMAIL_ACTION_SECRET=replace-with-a-distinct-long-random-secret
EMAIL_ACTION_TTL_HOURS=72
REMINDER_WORKER_INTERVAL_SECONDS=60
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_DELAY_MINUTES=15

# Optional global alert default; 0 keeps the automatic proportional lead window.
DEFAULT_DUE_SOON_LEAD_DAYS=0

# Optional local paths (compose overrides these for container runtime)
# DATABASE_PATH=./tasks.db
# BACKUP_DIR=./backups
